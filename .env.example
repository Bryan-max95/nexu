MAIL_FROM_EMAIL=
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_EMAIL=
GMAIL_PASSWORD=
YOUR_EMAIL=
ENCRYPTION_KEY=
